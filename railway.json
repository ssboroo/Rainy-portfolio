{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm run build:railway"
  },
  "deploy": {
    "startCommand": "pnpm run start:railway",
    "healthcheckPath": "/api/content",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  }
}
