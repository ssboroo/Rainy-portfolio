{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "noEmit": true
  },
  "include": [
    "app",
    "server"
  ]
}