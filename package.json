{
  "name": "boroo-steppe",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "npm run build:client && tsc --project tsconfig.server.json && node scripts/run-framework.mjs build",
    "test": "vitest run",
    "predev": "node scripts/asset-manifest.mjs",
    "build:client": "tsc --noEmit && node scripts/asset-manifest.mjs && vite build --config vite.client.config.ts && node scripts/prepare-client.mjs"
  },
  "dependencies": {
    "three": "0.180.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "3.2.4",
    "jsdom": "26.1.0",
    "@types/node": "22.18.6",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "wrangler": "4.92.0",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  }
}